          },
          {
            "type": "Button",
            "id": 22,
            "properties": {
              "systemImage": "arrow.up",
              "imageScale": "medium",
              "buttonStyle": "plain",
              "actionID": "pipeline.move.up",
              "disabled": true,
              "frame": { "width": 32, "height": 32 }
            }
          },
          {
            "type": "Button",
            "id": 23,
            "properties": {
              "systemImage": "arrow.down",
              "imageScale": "medium",
              "buttonStyle": "plain",
              "actionID": "pipeline.move.down",
              "disabled": true,
              "frame": { "width": 32, "height": 32 }
            }
          },
          {
            "type": "Spacer"
          },
          {
            "type": "Button",
            "id": 24,
            "properties": {
              "systemImage": "square.and.arrow.up",
              "imageScale": "medium",
              "buttonStyle": "plain",
              "actionID": "pipeline.export",
              "frame": { "width": 32, "height": 32 }
            }
          }
        ]
      },
      {
        "type": "Picker",
        "id": 30,
        "properties": {
          "title": "Add Plugin:",
          "options": [],
          "pickerStyle": "menu",
          "actionID": "plugin.picker.changed"
        }
      }
    ]
  },
  "detail": {
    "type": "VStack",
    "properties": {
      "spacing": 8.0,
      "padding": {
        "top": 8,
        "leading": 12,
        "bottom": 8,
        "trailing": 12
      }
    },
    "children": [
      {
        "type": "GroupBox",
        "properties": {
          "title": "Preview"
        },
        "children": [
          {
            "type": "Image",
            "id": 50,
            "properties": {
              "systemName": "photo",
              "resizable": true,
              "scaleMode": "fit",
