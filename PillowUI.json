{
  "type": "NavigationSplitView",
  "properties": {
    "style": "balanced",
    "frame": {
      "minWidth": 800,
      "minHeight": 550,
      "idealWidth": 1000,
      "idealHeight": 700
    }
  },
  "sidebar": {
    "type": "VStack",
    "properties": {
      "alignment": "leading",
      "spacing": 10.0,
      "padding": "default",
      "navigationSplitViewColumnWidth": {
        "ideal": 300,
        "min": 240,
        "max": 420
      }
    },
    "children": [
      {
        "type": "Text",
        "properties": {
          "text": "Pipeline",
          "font": "headline"
        }
      },
      {
        "type": "Table",
        "id": 10,
        "properties": {
          "columns": ["#", "Plugin"],
          "widths": [30, 200],
          "actionID": "pipeline.selection.changed"
        }
      },
      {
        "type": "HStack",
        "properties": {
          "spacing": 0
        },
        "children": [
          {
            "type": "Button",
            "id": 20,
            "properties": {
              "systemImage": "plus.circle",
              "imageScale": "large",
              "buttonStyle": "plain",
              "actionID": "pipeline.add",
              "frame": { "width": 32, "height": 32 }
            }
          },
          {
            "type": "Button",
            "id": 21,
            "properties": {
              "systemImage": "minus.circle",
              "imageScale": "large",
              "buttonStyle": "plain",
